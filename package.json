{
  "name": "vibecheck-app",
  "version": "1.5.5",
  "description": "See how much Claude you have left — session and weekly usage, real percentages, and Claude's live status, on one key.",
  "main": "main.js",
  "scripts": {
    "start": "node launch.js",
    "test": "node --test",
    "dist": "electron-builder"
  },
  "license": "PolyForm-Noncommercial-1.0.0",
  "author": {
    "name": "Josef Bednar",
    "email": "osobni@josefbednar.com"
  },
  "build": {
    "appId": "com.bednarjosef.vibecheck",
    "productName": "vibecheck",
    "npmRebuild": false,
    "files": [
      "main.js",
      "preload.js",
      "settings-preload.js",
      "index.html",
      "settings.html",
      "gnome-shortcut.js",
      "kde-shortcut.js",
      "desktop-integration.js",
      "launch.js",
      "usage.js",
      "account.js",
      "keys.js",
      "statusline-shim.js",
      "assets/tray-*.png",
      "fonts/**/*"
    ],
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64",
            "arm64"
          ]
        },
        {
          "target": "deb",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "category": "Utility",
      "synopsis": "Tap a key, see Claude's live status",
      "icon": "build/icon.png",
      "executableName": "vibecheck"
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "category": "public.app-category.utilities"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ]
    },
    "publish": {
      "provider": "github",
      "owner": "bednarjosef",
      "repo": "vibecheck",
      "releaseType": "release"
    },
    "appImage": {
      "artifactName": "vibecheck-${version}-${arch}.${ext}"
    },
    "deb": {
      "artifactName": "vibecheck_${version}_${arch}.${ext}"
    },
    "dmg": {
      "artifactName": "vibecheck-${version}-${arch}.${ext}"
    },
    "nsis": {
      "artifactName": "vibecheck-Setup-${version}-${arch}.${ext}"
    }
  },
  "dependencies": {
    "electron": "^31.0.0",
    "uiohook-napi": "^1.5.4"
  },
  "devDependencies": {
    "electron-builder": "^26.15.3"
  },
  "productName": "vibecheck",
  "bin": {
    "vibecheck": "launch.js"
  },
  "files": [
    "main.js",
    "preload.js",
    "settings-preload.js",
    "index.html",
    "settings.html",
    "gnome-shortcut.js",
    "kde-shortcut.js",
    "desktop-integration.js",
    "launch.js",
    "usage.js",
    "account.js",
    "keys.js",
    "statusline-shim.js",
    "assets/tray-*.png",
    "fonts/jetbrains-mono-400.woff2",
    "fonts/jetbrains-mono-600.woff2",
    "fonts/OFL.txt",
    "build/icon.png",
    "build/icon.icns",
    "build/icon.ico",
    "LICENSE.md"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bednarjosef/vibecheck.git"
  },
  "keywords": [
    "claude",
    "claude-code",
    "codex",
    "status",
    "ai",
    "tray",
    "overlay",
    "usage",
    "rate-limits",
    "tokens"
  ]
}
